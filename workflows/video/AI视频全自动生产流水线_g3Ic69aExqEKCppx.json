        "jsCode": "const items = $input.all();\n\nconst folder_name = $('beautify_response').first().json.folder_name;\n\n//const tsBase = new Date().toISOString().replace(/[:.]/g, '-');\n\nconst output = items.map((item, index) => {\n  const b64 = item.json.data[0].b64_json;\n\n  const file_name = `${folder_name}_image_${index + 1}.png`;\n\n  item.binary = {\n    image: {\n      data: b64,              // \u76f4\u63a5\u7528 base64 \u5b57\u7b26\u4e32\n      mimeType: 'image/png',\n      file_name: file_name,\n    },\n  };\n\n  item.json.file_name = file_name;\n  item.json.folder_name = folder_name;\n\n  return item;\n});\n\nreturn output;\n"
      },
