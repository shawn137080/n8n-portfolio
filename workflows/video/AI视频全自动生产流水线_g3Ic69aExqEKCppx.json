    {
      "parameters": {
        "jsCode": "// \u53ea\u62ff\u7b2c\u4e00\u4e2a\u8f93\u5165\uff08\u4f60\u73b0\u5728\u5c31\u662f 1 \u4e2a\uff09\nconst input = $input.first().json;\n\n// \u62ff\u5230\u5927\u6a21\u578b\u5410\u51fa\u7684\u90a3\u6bb5 JSON \u5b57\u7b26\u4e32\nconst raw = input.content.parts[0].text;\n\n// \u89e3\u6790\u6210\u771f\u6b63\u7684\u6570\u7ec4\nconst arr = JSON.parse(raw);\n\n// \u628a\u6570\u7ec4\u91cc\u7684\u6bcf\u4e00\u4e2a {script, image_prompt, wordcount} \u53d8\u6210\u4e00\u4e2a n8n item\nconst result = arr.map((seg, index) => {\n  let s = seg.script || '';\n\n  // \u53bb\u6389\u8f6c\u4e49\u5b57\u7b26\uff0c\u628a \\\\n \u53d8\u6210\u771f\u6b63\u7684\u6362\u884c\n  s = s\n    .replace(/\\\\n/g, '\\n')\n    .replace(/\\\\t/g, '\\t')\n    .replace(/\\\\\"/g, '\"')\n    .replace(/\\\\\\\\/g, '\\\\');\n\n  return {\n    json: {\n      id: index + 1,           // \u53ef\u9009\uff1a\u7b2c\u51e0\u6bb5\n      script: s,               // \u8fd9\u4e00\u6bb5\u7684\u6b63\u6587\n      wordcount: seg.wordcount,\n      prompt: seg.image_prompt,// \u8fd9\u4e00\u6bb5\u7684\u56fe\u50cf prompt\n      file_name:seg.file_name,\n      folder_name:seg.folder_name\n    \n    }\n  };\n});\n\n// \u5f88\u91cd\u8981\uff1a\u76f4\u63a5 return \u6570\u7ec4\uff0c\u8ba9\u540e\u9762\u8282\u70b9\u62ff\u5230 N \u4e2a item\nreturn result;\n"
      },
