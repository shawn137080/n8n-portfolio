    {
      "id": "423be45f-77dc-46dd-b2a9-1a9571cf5446",
      "name": "Build LLM prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const kbText = ($('Parse KB to context').first().json.kbText) || '';\nconst email = $json;\nconst fromAddr = email.from?.value?.[0]?.address || email.from?.text || '';\nconst subject = email.subject || '';\nconst body = email.textPlain || email.body || email.snippet || '';\n\nconst systemPrompt = [\n  'You are a triage agent for Gadget & More Electronics customer support.',\n  'Decide if the email is about one of the topics in the knowledge base below.',\n  'Reply ONLY with a JSON object of this exact shape (no prose, no markdown fences):',\n  '{\"in_scope\": <bool>, \"category\": \"<shipping|returns|warranty|billing|subscriptions|privacy|gift-cards|pricing|general>\", \"draft_reply\": \"<string>\", \"reasoning\": \"<one short sentence>\"}',\n  '',\n  'Rules:',\n  '- in_scope = true only if the question matches a topic in the knowledge base.',\n  '- draft_reply must be a polite, concise reply (3-6 sentences) that uses the relevant KB chunk.',\n  '- If in_scope is false, set draft_reply to \"\" and reasoning should briefly say why.',\n  '- Always start the draft reply with a greeting and end with a sign-off (\"Thanks, Gadget & More Support\").',\n  '',\n  'Knowledge base:',\n  kbText\n].join('\\n');\n\nconst userPrompt = 'From: ' + fromAddr + '\\nSubject: ' + subject + '\\n\\n' + body;\n\nreturn [{ json: { systemPrompt, userPrompt, threadId: email.threadId, messageId: email.id, from: fromAddr, subject } }];"
      }
    },
    {
      "id": "2c4a9484-3469-4b3a-960f-eaaa8e9f038b",
      "name": "Classify and draft reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
