    {
      "id": "c011c1e1-2ff5-42f6-8690-df578a4147a9",
      "name": "Parse KB to context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        32
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nlet kbText = '';\nfor (const item of items) {\n  const data = item.binary?.data;\n  if (!data) continue;\n  const text = Buffer.from(data.data, 'base64').toString('utf-8');\n  for (const line of text.split('\\n')) {\n    if (!line.trim()) continue;\n    try { const obj = JSON.parse(line); kbText += '[' + obj.category.toUpperCase() + '] ' + obj.text + '\\n\\n'; } catch (e) {}\n  }\n}\nreturn [{ json: { kbText, chunkCount: (kbText.match(/\\[/g) || []).length } }];"
      }
    },
    {
      "id": "221adca1-b968-4bde-ad68-4e91d0cbcc6c",
      "name": "Fetch unread inbox mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20,
        "filters": {
