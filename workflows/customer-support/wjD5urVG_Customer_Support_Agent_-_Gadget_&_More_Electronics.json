    {
      "id": "e072740c-24cc-4634-a0eb-eec14e15fde8",
      "name": "Parse LLM JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw = $json.text || $json.output || '';\nlet parsed = { in_scope: false, category: 'general', draft_reply: '', reasoning: 'no parse' };\ntry { const match = raw.match(/\\{[\\s\\S]*\\}/); if (match) parsed = JSON.parse(match[0]); } catch (e) { parsed.reasoning = 'parse error: ' + e.message; }\nreturn [{ json: { in_scope: parsed.in_scope === true, category: parsed.category || 'general', draft_reply: parsed.draft_reply || '', reasoning: parsed.reasoning || '', threadId: $('Build LLM prompt').item.json.threadId, from: $('Build LLM prompt').item.json.from, subject: $('Build LLM prompt').item.json.subject } }];"
      }
    },
    {
      "id": "013c8653-aaac-45b9-b412-6fa6912f2322",
      "name": "In scope?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1472,
