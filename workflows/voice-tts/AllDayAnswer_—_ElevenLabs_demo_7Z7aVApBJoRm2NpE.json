      },
      "id": "a1b2c3d4-0005-4001-8001-000000000005",
      "name": "Insert Call Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $('Validate & Merge').first().json;\nconst recording = d.recording_url ? '\\n\ud83c\udf99\ufe0f \u5f55\u97f3\uff1a' + d.recording_url : '';\nconst text =\n  '\ud83d\udea8 <b>\u65b0\u5de5\u5355\u6765\u5566\uff01' + d.owner_name + '\u8001\u677f\u8bf7\u6ce8\u610f</b>\\n\\n' +\n  '\ud83d\udc64 \u5ba2\u6237\uff1a' + d.customer_name + '\\n' +\n  '\ud83d\udccd \u4f4d\u7f6e\uff1a' + d.location + '\\n' +\n  '\ud83d\udd27 \u63cf\u8ff0\uff1a' + d.issue + '\\n' +\n  '\ud83d\udcde \u7535\u8bdd\uff1a' + d.caller_number + recording;\n\nreturn [{ json: { tg_chat_id: d.tg_chat_id, tg_message: text } }];"
      },
