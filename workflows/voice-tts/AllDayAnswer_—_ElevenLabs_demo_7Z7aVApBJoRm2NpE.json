      ],
      "webhookId": "ada00001-e11b-4b05-8000-a11dayanswer1"
    },
    {
      "parameters": {
        "jsCode": "// Parse ElevenLabs post-call webhook payload\nconst body = $input.first().json.body || $input.first().json;\n\nconst agentId = body.agent_id || '';\nconst conversationId = body.conversation_id || '';\n\nconst dataCollection = body.analysis?.data_collection || {};\nconst customerName = dataCollection.customer_name?.value || dataCollection.customer_name || '';\nconst location = dataCollection.location?.value || dataCollection.location || '';\nconst issue = dataCollection.issue?.value || dataCollection.issue || '';\n\nconst transcriptArr = body.transcript || [];\nconst transcript = transcriptArr.map(t => t.role + ': ' + t.message).join('\\n');\n\nconst callDuration = body.metadata?.call_duration_secs || 0;\nconst recordingUrl = body.metadata?.recording?.url || '';\nconst callerNumber =\n  body.conversation_initiation_client_data?.custom_llm_extra_body?.caller_number ||\n  body.metadata?.caller_number ||\n  body.call?.from_number ||\n  '';\n\nreturn [{\n  json: {\n    agent_id: agentId,\n    conversation_id: conversationId,\n    customer_name: customerName,\n    location: location,\n    issue: issue,\n    transcript: transcript,\n    call_duration: callDuration,\n    recording_url: recordingUrl,\n    caller_number: callerNumber,\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4001-8001-000000000002",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {
        "url": "=https://fjjcwooebuhapugpopud.supabase.co/rest/v1/clients?agent_id=eq.{{$json.agent_id}}&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<SUPABASE_SERVICE_ROLE_KEY>"
            },
            {
              "name": "Authorization",
              "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4001-8001-000000000003",
      "name": "Get Client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst clients = Array.isArray(response) ? response : [response];\n\nif (clients.length === 0 || !clients[0].agent_id) {\n  throw new Error('Client not found for agent_id: ' + $('Parse Payload').first().json.agent_id);\n}\n\nconst c = clients[0];\nconst p = $('Parse Payload').first().json;\n\nreturn [{\n  json: {\n    owner_name: c.owner_name,\n    owner_email: c.owner_email,\n    tg_chat_id: c.tg_chat_id,\n    agent_id: p.agent_id,\n    conversation_id: p.conversation_id,\n    customer_name: p.customer_name || 'Unknown',\n    location: p.location || 'Not provided',\n    issue: p.issue || 'Not described',\n    transcript: p.transcript,\n    call_duration: p.call_duration,\n    recording_url: p.recording_url,\n    caller_number: p.caller_number || 'Unknown',\n  }\n}];"
      },
      "id": "a1b2c3d4-0004-4001-8001-000000000004",
      "name": "Validate & Merge",
      "type": "n8n-nodes-base.code",
