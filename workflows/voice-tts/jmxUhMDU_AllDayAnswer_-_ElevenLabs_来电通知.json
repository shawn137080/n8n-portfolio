    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst clients = Array.isArray(response) ? response : [response];\nif (clients.length === 0 || !clients[0].agent_id) {\n  throw new Error('Client not found: ' + $('Parse Payload').first().json.agent_id);\n}\nconst c = clients[0];\nconst p = $('Parse Payload').first().json;\nreturn [{ json: { owner_name: c.owner_name, owner_email: c.owner_email, tg_chat_id: c.tg_chat_id, agent_id: p.agent_id, conversation_id: p.conversation_id, customer_name: p.customer_name || 'Unknown', location: p.location || 'Not provided', issue: p.issue || 'Not described', transcript: p.transcript, call_duration: p.call_duration, recording_url: p.recording_url, caller_number: p.caller_number || 'Unknown' } }];"
