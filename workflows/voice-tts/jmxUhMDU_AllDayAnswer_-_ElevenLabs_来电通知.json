      "parameters": {
        "jsCode": "const d = $('Validate & Merge').first().json;\nconst recording = d.recording_url ? '\\n\ud83c\udf99\ufe0f Recording\uff1a' + d.recording_url : '';\nconst text = '\ud83d\udea8 <b>Hey\uff01' + d.owner_name + 'new booking</b>\\n\\n' +\n  '\ud83d\udc64 Name\uff1a' + d.customer_name + '\\n' +\n  '\ud83d\udccd Location\uff1a' + d.location + '\\n' +\n  '\ud83d\udd27 Description\uff1a' + d.issue + '\\n' +\n  '\ud83d\udcde Phone\uff1a' + d.caller_number + recording;\nreturn [{ json: { tg_chat_id: d.tg_chat_id, tg_message: text } }];"
