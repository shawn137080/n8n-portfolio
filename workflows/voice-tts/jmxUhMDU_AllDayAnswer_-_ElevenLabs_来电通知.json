    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n// ElevenLabs real payload: { type, event_timestamp, data: { agent_id, conversation_id, transcript, analysis, ... } }\nconst body = raw.data || raw;\n\nconst agentId = body.agent_id || '';\nconst conversationId = body.conversation_id || '';\n\n// data_collection_results is a dict: { fieldName: { value, operator, data_collection_id } }\nconst dc = body.analysis?.data_collection_results || body.analysis?.data_collection || {};\n\n// ElevenLabs Data Collection fields: name, address, post code, number\nconst customerName = dc['name']?.value || dc['name'] || dc['customer_name']?.value || dc['customer_name'] || '';\nconst address = dc['address']?.value || dc['address'] || '';\nconst postCode = dc['post code']?.value || dc['post code'] || dc['postcode']?.value || dc['postcode'] || '';\nconst location = [address, postCode].filter(Boolean).join(', ') || dc['location']?.value || dc['location'] || '';\nconst issue = dc['issue']?.value || dc['issue'] || dc['problem']?.value || dc['problem'] || '';\n\n// Customer-provided phone number (from conversation)\nconst customerPhone = dc['number']?.value || dc['number'] || dc['phone']?.value || dc['phone'] || '';\n\nconst transcriptArr = body.transcript || [];\nconst transcript = transcriptArr.map(t => (t.role || t.speaker || '') + ': ' + (t.message || t.text || '')).join('\\n');\n\nconst callDuration = body.metadata?.call_duration_secs || body.call_length || 0;\nconst recordingUrl = body.metadata?.recording?.url || body.recording_url || '';\n\n// Caller number from Twilio metadata (the actual incoming caller ID)\nconst callerNumber =\n  body.conversation_initiation_client_data?.custom_llm_extra_body?.caller_number ||\n  body.metadata?.caller_number ||\n  body.call?.from_number ||\n  body.caller_id ||\n  customerPhone || '';\n\nreturn [{ json: { agent_id: agentId, conversation_id: conversationId, customer_name: customerName, location, issue, transcript, call_duration: callDuration, recording_url: recordingUrl, caller_number: callerNumber, customer_phone: customerPhone } }];"
      },
