              "id": "next-steps",
              "name": "nextSteps",
              "value": "1. Review generated story\n2. Check voiceover quality\n3. Verify images match scenes\n4. Assemble with FFmpeg or Remotion\n5. Upload to YouTube",
              "type": "string"
            }
          ]
        }
      },
      "id": "final-output",
      "name": "Final Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1780,
        300
      ]
    }
