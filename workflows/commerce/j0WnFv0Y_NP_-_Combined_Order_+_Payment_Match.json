    {
      "id": "5dbcc40f-18d9-42ed-b401-a6ddfae8425b",
      "name": "Check Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst code = item.code;\nif (!code) { return null; }\nconst all = await $('DataTable \u2014 Read All').all();\nlet match = null;\nlet isDuplicate = false;\nfor (const row of all) {\n  if (item.emailId && ((item.kind === 'order' && row.json.order_emailId === item.emailId) || (item.kind === 'payment' && row.json.payment_emailId === item.emailId))) { isDuplicate = true; break; }\n  if (row.json.code === code && row.json.status !== 'complete') { match = row.json; }\n}\nif (isDuplicate) { return null; }\nreturn { json: { ...item, partner: match, status: match ? 'complete' : 'waiting' } };"
      }
    },
    {
      "id": "e93431d0-7c71-4f65-bab8-2b841738e4f9",
      "name": "Fill or Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nif (item.status !== 'complete') {\n  if (item.kind === 'order') {\n    return { json: { code: item.code, name: item.name, payment: item.payment, pickup_time: item.pickup_time, status: 'waiting_payment', order_emailId: item.emailId, order_at: new Date().toISOString() } };\n  } else {\n    return { json: { code: item.code, payment: item.payment, payment_ref: item.payment_ref, status: 'waiting_order', payment_emailId: item.emailId, payment_at: new Date().toISOString() } };\n  }\n}\nconst partner = item.partner || {};\nlet merged = {};\nif (item.kind === 'order') {\n  merged = { code: item.code, name: item.name, payment: partner.payment || item.payment, pickup_time: item.pickup_time, payment_ref: partner.payment_ref, status: 'complete' };\n  merged.order_emailId = item.emailId;\n  merged.order_at = new Date().toISOString();\n} else {\n  merged = { code: item.code, name: partner.name, payment: item.payment, pickup_time: partner.pickup_time, payment_ref: item.payment_ref, status: 'complete' };\n  if (partner.order_at) merged.order_at = partner.order_at;\n  if (partner.order_emailId) merged.order_emailId = partner.order_emailId;\n  merged.payment_at = new Date().toISOString();\n  merged.payment_emailId = item.emailId;\n}\nreturn { json: merged };",
        "parameters": {
          "jsCode": "const item = $input.item.json;\\nif (item.status !== 'complete') {\\n  if (item.kind === 'order') {\\n    return { json: { code: item.code, name: item.name, payment: item.payment, pickup_time: item.pickup_time, status: 'waiting_payment', order_emailId: item.emailId, order_at: new Date().toISOString() } };\\n  } else {\\n    return { json: { code: item.code, payment: item.payment, payment_ref: item.payment_ref, status: 'waiting_order', payment_emailId: item.emailId, payment_at: new Date().toISOString() } };\\n  }\\n}\\nconst partner = item.partner || {};\\nlet merged = {};\\nif (item.kind === 'order') {\\n  merged = { code: item.code, name: item.name, payment: partner.payment || item.payment, pickup_time: item.pickup_time, payment_ref: partner.payment_ref, status: 'complete' };\\n  merged.order_emailId = item.emailId;\\n  merged.order_at = new Date().toISOString();\\n} else {\\n  merged = { code: item.code, name: partner.name, payment: item.payment, pickup_time: partner.pickup_time, payment_ref: item.payment_ref, status: 'complete' };\\n  if (partner.order_at) merged.order_at = partner.order_at;\\n  if (partner.order_emailId) merged.order_emailId = partner.order_emailId;\\n  merged.payment_at = new Date().toISOString();\\n  merged.payment_emailId = item.emailId;\\n}\\nmerged.completed_at = new Date().toISOString();\\nreturn { json: merged };"
        }
      }
