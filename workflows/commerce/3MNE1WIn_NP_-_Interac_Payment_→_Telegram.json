  "nodes": [
    {
      "id": "754042ad-7e79-4b3b-96a6-9bf7e8c381d7",
      "name": "Gmail Trigger \u2014 Interac Payment",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        },
        "event": "messageReceived",
        "simple": false,
        "maxResults": 20,
        "filters": {
          "q": "from:(notify@payments.interac.ca OR interac.ca) newer_than:1d",
          "readStatus": "unread"
        },
        "credentials": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "ZSCPN3QX8yFyhqu3",
          "name": "sean_demo"
        }
