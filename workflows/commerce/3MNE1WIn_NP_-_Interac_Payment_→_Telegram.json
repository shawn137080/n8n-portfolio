    },
    {
      "id": "f3064de6-37c1-4d5c-a357-de754cc28b65",
      "name": "Parse Interac Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst text = (item.text || item.snippet || '').replace(/\\r?\\n/g, ' ').replace(/\\s+/g, ' ');\nconst subject = item.subject || '';\nconst combined = subject + ' ' + text;\nconst amountMatch = combined.match(/\\$\\s?([0-9]+(?:\\.[0-9]{1,2})?)|(?:CAD|USD|HKD)\\s?([0-9]+(?:\\.[0-9]{1,2})?)|([0-9]+(?:\\.[0-9]{1,2})?)\\s?(?:CAD|USD|HKD)/i);\nconst refMatch = combined.match(/(?:reference number|reference|\u53c3\u8003\u7de8\u865f|\u53c3\u8003\u865f)[\\s:\uff1a#]*([A-Za-z0-9][A-Za-z0-9\\-]{4,30})/i);\nconst sentFromMatch = combined.match(/(?:sent from|sender|from|\u5bc4\u4ef6\u4eba)[\\s:\uff1a]+([A-Za-z\u4e00-\u9fff][A-Za-z0-9\u4e00-\u9fff .\\-]{0,40}?)(?:\\n|amount|reference|$)/i);\nconst messageMatch = combined.match(/(?:message|\u5099\u8a3b|\u7559\u8a00|note)[\\s:\uff1a]+([A-Za-z0-9][A-Za-z0-9\\-]{2,20})/i);\nconst code = (messageMatch ? messageMatch[1].trim() : null) || (refMatch ? refMatch[1].trim() : null);\nif (!code) { return null; }\nlet amount = null;\nif (amountMatch) { amount = amountMatch[1] || amountMatch[2] || amountMatch[3]; }\nreturn { json: { code: code, payment: amount, payment_ref: refMatch ? refMatch[1].trim() : null, from: item.from, subject: subject, emailId: item.id } };"
      }
    },
    {
      "id": "cafd70da-551a-4249-8330-0cd6e83ef66e",
      "name": "Filter \u2014 Has Code",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.code }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "5e1e0e2d-d331-4248-a0b7-01fba9eb6fd1",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "<__PLACEHOLDER_VALUE__Your Telegram chat ID (e.g. 123456789)__>",
        "text": "=\u2705 <b>Payment received</b>\n\n\ud83d\udcb0 Amount: ${{ $json.payment }}\n\ud83d\udd16 Code: <code>{{ $json.code }}</code>\n\ud83d\udcc4 Ref: <code>{{ $json.payment_ref }}</code>",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "zJ0hh2kPPRpB2LtE",
          "name": "Telegram account"
        }
      },
      "webhookId": "877b66ae-9191-4010-84ed-66eb131c9296"
    }
  ],
  "connections": {
