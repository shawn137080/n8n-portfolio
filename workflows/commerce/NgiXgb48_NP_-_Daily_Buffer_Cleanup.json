      "name": "Find Abandoned",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\nconst abandoned = [];\nfor (const item of items) {\n  const d = item.json;\n  if (d.status !== 'waiting_payment' && d.status !== 'waiting_order') { continue; }\n  const ts = d.order_at || d.payment_at;\n  if (!ts) { continue; }\n  if (new Date(ts).getTime() < cutoff) { abandoned.push(d); }\n}\nreturn [{ json: { abandoned: abandoned, count: abandoned.length, ran_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "2c6ec1b7-7587-4706-9683-99d4840f6eaa",
      "name": "Filter \u2014 Has Abandoned",
      "type": "n8n-nodes-base.filter",
