        }
      }
    },
    {
      "id": "e0d59e21-f29b-4d94-8b68-f9a9a039e91c",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst count = item.count || 0;\nconst abandoned = item.abandoned || [];\nif (count === 0) {\n  return [{ json: { text: '\ud83e\uddf9 NP cleanup: no abandoned jobs', count: 0 } }];\n}\nconst lines = ['\ud83e\uddf9 <b>NP cleanup: ' + count + ' abandoned job(s)</b>', ''];\nfor (const d of abandoned) {\n  lines.push('\u2022 ' + d.code + ' \u2014 ' + d.status + ' \u2014 ' + (d.name || d.payment_ref || '?'));\n}\nreturn [{ json: { text: lines.join('\\n'), count: count, codes: abandoned.map(d => d.code) } }];"
      }
    },
