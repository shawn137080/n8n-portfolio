    {
      "id": "237a4eff-c417-4840-bcc7-234ec6b90df3",
      "name": "Parse Order Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nconst text = (item.text || item.snippet || '').replace(/\\r?\\n/g, ' ').replace(/\\s+/g, ' ');\nconst subject = item.subject || '';\nconst combined = subject + ' ' + text;\nconst codeMatch = combined.match(/(?:validation code|\u9a57\u8b49\u78bc|\u9a57\u8b49|code)[\\s:\uff1a]*([A-Za-z0-9][A-Za-z0-9\\-]{2,20})/i);\nconst amountMatch = combined.match(/(?:estimated total|total|\u91d1\u984d|\u5e94\u4ed8)[\\s:\uff1a]*\\$?\\s?([0-9]+(?:\\.[0-9]{1,2})?)/i);\nconst nameMatch = combined.match(/(?:pickup name|name|\u59d3\u540d|\u540d\u7a31|\u53d6\u8ca8\u4eba)[\\s:\uff1a]+([A-Za-z\u4e00-\u9fff][A-Za-z0-9\u4e00-\u9fff .\\-]{0,40}?)(?:[\\s,\uff0c.\u3002]|preferred|total|pickup|validation|estimated|$)/i);\nconst pickupMatch = combined.match(/(?:preferred pickup time|pickup time|pickup|\u53d6\u8ca8|\u53d6\u4ef6)[\\s:\uff1a]+([0-9]{1,2}:[0-9]{2}\\s*(?:AM|PM|am|pm)?\\s*[0-9]{0,2}\\/[0-9]{1,2}\\/[0-9]{2,4}|[0-9]{1,2}:[0-9]{2}\\s*(?:AM|PM|am|pm)|[0-9]{1,2}\\/[0-9]{1,2}\\/[0-9]{2,4}|[0-9]{4}\\-[0-9]{1,2}\\-[0-9]{1,2})/i);\nconst code = codeMatch ? codeMatch[1].trim() : null;\nif (!code) { return null; }\nreturn { json: { code: code, name: nameMatch ? nameMatch[1].trim() : null, payment: amountMatch ? amountMatch[1].trim() : null, pickup_time: pickupMatch ? pickupMatch[1].trim() : null, from: item.from, subject: subject, emailId: item.id } };"
      }
    },
    {
      "id": "35b2c409-cf64-470a-8d32-7fd1c9ed8c82",
      "name": "Filter \u2014 Has Code",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.code }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "bdf5b1a4-e172-4da4-8732-ed66ac93a68a",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "<__PLACEHOLDER_VALUE__Your Telegram chat ID (e.g. 123456789)__>",
        "text": "=\ud83d\udda8\ufe0f <b>New print job</b>\n\n\ud83d\udcb0 Payment: ${{ $json.payment }}\n\ud83d\udc64 Name: {{ $json.name }}\n\ud83d\udd16 Code: <code>{{ $json.code }}</code>\n\u23f0 Pickup: {{ $json.pickup_time }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "zJ0hh2kPPRpB2LtE",
          "name": "Telegram account"
        }
      },
      "webhookId": "bdee439d-fc77-4cce-8a35-91acd1efbad0"
    }
  ],
  "connections": {
