      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"completed\", \"episode\": $('Audio Input').item.json.episode_title, \"source_id\": $('Open Notebook: Store Source').item.json.id, \"duration_min\": $('Audio Input').item.json.audio_duration_minutes } }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
